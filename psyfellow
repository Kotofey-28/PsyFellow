def work_with_self_excel_table(message):
    try:
        file_info = bot.get_file(message.document.file_id)
        downloaded_file = bot.download_file(file_info.file_path)

        with open(file_name, 'wb') as table:
            table.write(downloaded_file)

        df = pd.read_excel(file_name) #Перевод таблицы в DataFrame
        global nodes, weighted_edges, degrees
        nodes = []
        weighted_edges = []
        edges_for_max_min = []
        degrees = {}

        for ind in df.index: #Заполнение списка рёбер
            for column in df.columns[1:]:
                if str(df.loc[ind, column]).isdigit() and df.loc[ind, column] > 0:
                    weighted_edges.append(('\n'.join(str(df.loc[ind, df.columns[0]]).split()), '\n'.join(column.split()), df.loc[ind, column]))
                    edges_for_max_min.append((df.loc[ind, df.columns[0]], column, df.loc[ind, column]))

        for node in df.columns[1:]: #Заполнение списка вершин
            nodes.append('\n'.join(node.split()))

        nodes_for_max_min = []
        for node1 in df.columns[1:]:
            nodes_for_max_min.append(node1)

        global max_person
        max_choices = 0
        max_person = ''
        for i in nodes_for_max_min: #Выявление чаще всего выбираемого
            count_choices = 0
            for j in edges_for_max_min:
                if j[1] == i:
                    count_choices += j[2]
            if count_choices == max_choices:
                max_choices = count_choices
                max_person = max_person + i + ' '
            elif count_choices > max_choices:
                max_choices = count_choices
                max_person = i + ' '
            degrees[i] = int(count_choices)
        degrees = dict(sorted(degrees.items(), key=lambda item: item[1], reverse=True))

        global min_person
        min_choices = max_choices
        min_person = ''
        for i in nodes_for_max_min: #Выявление реже всего выбираемого
            count_choices = 0
            for j in edges_for_max_min:
                if j[1] == i:
                    count_choices += j[2]
            if count_choices == min_choices:
                min_choices = count_choices
                min_person = min_person + i + ' '
            elif count_choices < min_choices:
                min_choices = count_choices
                min_person = i + ' '

        draw_graph(message)
    except (Exception, TimeoutError):
        bot.register_next_step_handler(message, something_went_wrong)

def work_with_yandex_form_excel_table(message):
    try:
        file_info = bot.get_file(message.document.file_id)
        downloaded_file = bot.download_file(file_info.file_path)

        with open(file_name, 'wb') as table:
            table.write(downloaded_file)

        df = pd.read_excel(file_name)
        global nodes, weighted_edges, degrees, max_person, min_person
        nodes = []
        weighted_edges = []
        degrees = {}
        set_edges = set()
        max_person = ''
        min_person = ''

        for ind in df.index: #Заполнение списка рёбер
            for column in df.columns[1:]:
                if (''.join(str(df.loc[ind, column]).split())).isalpha() and (''.join(str(df.loc[ind, df.columns[0]]).split())).isalpha() and df.loc[ind, column] != '' and df.loc[ind, df.columns[0]] != '' and df.loc[ind, column] != df.loc[ind, df.columns[0]]:
                    set_edges.add(('\n'.join(str(df.loc[ind, df.columns[0]]).split()), '\n'.join(str(df.loc[ind, column]).split()), 1))
        weighted_edges = list(set_edges)

        for node in df.index: #Заполнение списка вершин
            nodes.append('\n'.join(df.loc[node, df.columns[0]].split()))

        for human in df.index: #Заполнение словаря с кол-вом выборов каждого человека
            count_choices = 0
            for ind in df.index:
                for column in df.columns[1:]:
                    if df.loc[ind, column] == df.loc[human, df.columns[0]] and df.loc[ind, column] != df.loc[ind, df.columns[0]]:
                        count_choices += 1
            degrees[df.loc[human, df.columns[0]]] = count_choices

        degrees = dict(sorted(degrees.items(), key=lambda item: item[1], reverse=True))

        max_choices = 0
        for name, choices in degrees.items(): #Выявление чаще всего выбираемого
            if choices > max_choices:
                max_choices = choices
                max_person = name
            elif choices == max_choices:
                max_person = max_person + ' ' + name

        min_choices = max_choices
        for name, choices in degrees.items(): #Выявление реже всего выбираемого
            if choices < min_choices:
                min_choices = choices
                min_person = name
            elif choices == min_choices:
                min_person = min_person + ' ' + name

        draw_graph(message)
    except (Exception, TimeoutError):
        bot.register_next_step_handler(message, something_went_wrong)

def draw_graph(message): #Построение графа
    try:
        G = nx.DiGraph(directed=True)
        G.add_nodes_from(nodes)
        G.add_weighted_edges_from(weighted_edges)

        edge_labels = nx.get_edge_attributes(G, 'weight')
        pos = nx.kamada_kawai_layout(G)
        graph_nodes_size = 2000-(len(nodes)*50)

        nx.draw(G, pos, with_labels=True, font_size=graph_nodes_size*0.01, node_size=graph_nodes_size, node_color='lightblue', arrowsize=6.5, width=0.5)
        #nx.draw_networkx_edge_labels(G, pos, edge_labels=edge_labels, label_pos=0.95*(1-(len(nodes)*0.01*1.5)), font_color='red', font_size=6)

        plt.savefig('socio-graph.png')
        plt.close()

        bot.send_message(message.chat.id, 'Всё получилось🎉\nВот готовый граф:')
        with open('socio-graph.png', 'rb') as graph:
            bot.send_photo(message.chat.id, graph)
        extra_info(message)
    except (Exception, TimeoutError):
        bot.register_next_step_handler(message, something_went_wrong)

